# ============================================================================
# NahaLabs WhatsApp Operator — environment template
# Copy to `.env` (never commit). All secrets MUST match the Core app.
# ============================================================================

# ---- Server ----
PORT=10000
NODE_ENV=production
LOG_LEVEL=info

# ---- PostgreSQL (Operator uses raw pg for Baileys session state) ----
# Requires PostgreSQL 13+ (gen_random_uuid()). Use Neon's connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ---- Shared secrets (must match the Core app exactly) ----
WEBHOOK_SECRET=change-me-32-random-chars
OPERATOR_API_KEY=change-me-long-random-key

# ---- Pairing QR lifetime (optional) ----
PAIRING_QR_TTL_SECONDS=120
