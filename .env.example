# ============================================================================
# NahaLabs Core App (Next.js on Vercel) — environment template
# Copy to `.env.local` (never commit real values).
# Build must pass with ZERO env vars; every value here is optional at build time.
# ============================================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---- AI (Vercel AI SDK — add a key per provider you use; the SDK routes to any) ----
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- NahaLabs Messaging Platform (WhatsApp Operator) ----
# Point at your Render service. Secrets MUST match the Operator's env vars.
OPERATOR_URL=https://your-operator.onrender.com
OPERATOR_API_KEY=change-me-long-random-key
WEBHOOK_SECRET=change-me-32-random-chars

# ---- Scheduling (cron-job.org triggers /api/cron/* routes with this secret) ----
CRON_SECRET=change-me-another-random

# ---- Email (Resend, optional) ----
RESEND_API_KEY=re_...
EMAIL_FROM="NahaLabs <hello@yourdomain.com>"

# ---- Payments (optional; behind a common abstraction) ----
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
STRIPE_SECRET_KEY=

# ---- Storage (optional; Vercel Blob is auto-injected on Vercel) ----
# For S3/R2-compatible storage instead:
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
